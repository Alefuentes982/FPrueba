# Copiar como .env en la VM (chmod 600 .env). Nunca subir a Git: aquí viven los secretos del entorno.
GHCR_OWNER=<usuario-o-organizacion-de-github-en-minusculas>
IMAGE_TAG=prod            # prod en la VM de producción, dev en la de dev/staging

# Base de datos (Supabase, Transaction pooler, rol app_backend) y autenticación
DATABASE_URL=postgresql://app_backend.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API
PORT=3000
NODE_ENV=production
TRUST_PROXY=2             # prod: balanceador + Nginx. En dev (sin balanceador) usar 1
CORS_ORIGIN=https://<dominio-prod>   # en dev: http://<ip-de-la-vm-dev>
EMPRESA_NOMBRE=
EMPRESA_RUT=
EMPRESA_DIRECCION=
DEVOLUCION_MAX_DIAS=30
